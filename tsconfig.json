{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": ["node", "chrome"]
  },
  "include": [
    "shared/**/*.ts",
    "shared/**/*.tsx",
    "extension/src/**/*.ts",
    "extension/src/**/*.tsx",
    "web/src/**/*.ts",
    "web/src/**/*.tsx"
  ]
}
